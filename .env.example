# Supabase (Auth, Postgres, RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only by scripts/seed.ts (Supabase project
# settings -> Database -> Connection string -> URI)
DATABASE_URL=

# Claude API — router only, never writes verse/tafsir text (spec section 10)
ANTHROPIC_API_KEY=
ROUTER_MODEL=claude-haiku-4-5-20251001

# "local" (default) reads the seeded Postgres tables. "quranpedia" enables the
# api.quranpedia.net stub (not implemented — spec section 3) and requires
# QURANPEDIA_CONTACT_ADDRESS.
TAFSIR_PROVIDER=local
QURANPEDIA_CONTACT_ADDRESS=

# Feature flags (spec section 10)
ENABLE_COMPARISON=false
SHOW_REVIEW_BADGE=true
